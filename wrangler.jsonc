{
  "name": "c-snowload-windregion",
  "account_id": "9e38ae900068839b9b99032199ba877f",
  "main": "cloudflare-worker/src/index.js",
  "compatibility_date": "2026-04-07",
  "observability": {
    "enabled": true
  },
  "containers": [
    {
      "class_name": "AhdApiContainer",
      "image": "./Dockerfile",
      "max_instances": 3
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "AHD_API",
        "class_name": "AhdApiContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "AhdApiContainer"
      ]
    }
  ]
}
